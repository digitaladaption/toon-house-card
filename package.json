{
  "name": "toon-house-card",
  "version": "0.8.0",
  "description": "A cartoon 3D dollhouse of your home for Home Assistant, built from a simple floor plan file",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/card.js --bundle --format=esm --minify --target=es2020 --loader:.woff2=dataurl --outfile=dist/toon-house-card.js && esbuild src/importer/app.js --bundle --format=esm --minify --target=es2020 --outfile=importer/importer.js",
    "watch": "esbuild src/card.js --bundle --format=esm --target=es2020 --outfile=dist/toon-house-card.js --watch",
    "test": "node test/geometry.test.mjs && node test/detect.test.mjs && node test/match.test.mjs && node test/weather.test.mjs",
    "demo": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "clipper-lib": "6.4.2",
    "esbuild": "0.24.0",
    "three": "0.186.1"
  }
}
